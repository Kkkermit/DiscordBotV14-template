{
	"name": "Protect main",
	"target": "branch",
	"enforcement": "active",
	"bypass_actors": [],
	"conditions": {
		"ref_name": {
			"include": ["refs/heads/main"],
			"exclude": []
		}
	},
	"rules": [
		{ "type": "deletion" },
		{ "type": "non_fast_forward" },
		{
			"type": "pull_request",
			"parameters": {
				"required_approving_review_count": 0,
				"dismiss_stale_reviews_on_push": true,
				"require_code_owner_review": false,
				"require_last_push_approval": false,
				"required_review_thread_resolution": true,
				"allowed_merge_methods": ["merge"]
			}
		},
		{
			"type": "required_status_checks",
			"parameters": {
				"strict_required_status_checks_policy": false,
				"required_status_checks": [
					{ "context": "Source branch", "integration_id": 15368 },
					{ "context": "Release version", "integration_id": 15368 },
					{ "context": "Lint and format", "integration_id": 15368 },
					{ "context": "Test (Node.js 24.x)", "integration_id": 15368 },
					{ "context": "Test (Node.js 26.x)", "integration_id": 15368 },
					{ "context": "Docker image", "integration_id": 15368 }
				]
			}
		}
	]
}
