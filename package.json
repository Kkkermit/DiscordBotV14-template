{
	"name": "discordbotv14-template",
	"version": "4.0.1",
	"private": true,
	"description": "A beginner-friendly discord.js v14 bot template with slash commands, prefix commands, events and optional MongoDB support.",
	"keywords": [
		"discord",
		"discord-bot",
		"discord.js",
		"discord-js-v14",
		"slash-commands",
		"bot-template",
		"mongodb",
		"mongoose"
	],
	"homepage": "https://github.com/Kkkermit/DiscordBotV14-template#readme",
	"bugs": {
		"url": "https://github.com/Kkkermit/DiscordBotV14-template/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kkkermit/DiscordBotV14-template.git"
	},
	"license": "MIT",
	"author": "Kkermit",
	"type": "commonjs",
	"main": "src/index.js",
	"scripts": {
		"start": "node src/index.js",
		"dev": "node --watch-path=src src/index.js",
		"setup": "node scripts/setup-env.js",
		"prepare-release": "node scripts/prepare-release.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test \"test/**/*.test.js\"",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=80 \"test/**/*.test.js\"",
		"check": "npm run lint && npm run format:check && npm test",
		"prepare": "husky || true"
	},
	"dependencies": {
		"discord.js": "^14.28.1",
		"figlet": "^1.13.0",
		"mongoose": "^9.13.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"!(*.js)": "prettier --write --ignore-unknown"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
