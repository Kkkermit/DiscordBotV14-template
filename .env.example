# Copy this file to ".env" and fill in your values, or run "npm run setup" to do it interactively.
# Never commit your .env file or share your token. Anyone with it can control your bot.

# Required. Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=

# Optional. Your test server's ID. When set, slash commands are registered there and update instantly.
# Leave empty to register commands globally (in every server, can take up to an hour to update).
DISCORD_GUILD_ID=

# Optional. Comma-separated user IDs allowed to run commands marked "developerOnly".
DEVELOPER_IDS=

# Optional. MongoDB connection string. Leave empty to run without a database.
MONGODB_URI=

# Optional. How much to log: debug, info, warn or error. Defaults to info.
LOG_LEVEL=info
